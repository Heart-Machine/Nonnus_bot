BOT_TOKEN=123456789:replace_with_token_from_botfather

# Optional. Useful when Instagram blocks anonymous downloads.
# Export cookies from your own browser session in Netscape format.
COOKIES_FILE=

# Telegram may reject large uploads depending on current Bot API limits.
MAX_FILE_SIZE_MB=50

# Telegram's photo limit is much lower than the video one. Photos above this
# are re-encoded to JPEG before sending.
PHOTO_MAX_FILE_SIZE_MB=10

# Longest side a re-encoded photo is scaled down to.
PHOTO_MAX_DIMENSION=2560

# Timeout for fetching a single photo from Instagram's CDN.
PHOTO_DOWNLOAD_TIMEOUT_SECONDS=60

# Increase this if Telegram upload times out on larger videos or slow connections.
UPLOAD_TIMEOUT_SECONDS=180

# Compress videos larger than MAX_FILE_SIZE_MB before uploading to Telegram.
ENABLE_VIDEO_COMPRESSION=true

# Target compressed size. Keep this slightly below MAX_FILE_SIZE_MB.
VIDEO_COMPRESSION_TARGET_MB=49

# Comma-separated steps, each a bound on the long side of the frame:
# 1280 means 720x1280 for a vertical Reel and 1280x720 for a landscape video.
# A frame smaller than the bound is left as it is, never enlarged.
VIDEO_COMPRESSION_HEIGHTS=1280,854,640

# Audio bitrate for compressed videos.
VIDEO_COMPRESSION_AUDIO_KBPS=96

# ffmpeg x264 preset: ultrafast, superfast, veryfast, faster, fast, medium.
VIDEO_COMPRESSION_PRESET=veryfast

# Lower bound for video bitrate during compression.
VIDEO_COMPRESSION_MIN_VIDEO_KBPS=250

# Users are served side by side; this caps how many posts are downloaded, or
# have their videos compressed, at the same time. Requests past it wait for a
# slot while cached posts and everything else go on.
MAX_PARALLEL_DOWNLOADS=3

# Optional. A public Instagram post the bot downloads a few minutes after
# every start and then once a day. When that fails - usually because
# Instagram has broken yt-dlp - the storage chat hears about it, and again
# when it works after that. Empty turns the check off.
CANARY_POST_URL=

# Required for Telegram Inline Mode.
# Create a private group/channel, add the bot, send /chatid there, and paste the ID here.
STORAGE_CHAT_ID=

# Optional. SQLite database with the Telegram file_id cache of prepared posts.
INLINE_CACHE_DB=.inline_cache.sqlite3

# Optional. The JSON file the cache was kept in before INLINE_CACHE_DB. Its
# posts are carried into the database once, when the database is created.
INLINE_CACHE_FILE=.inline_cache.json
